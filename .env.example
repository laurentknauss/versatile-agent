# ------------------ LangSmith tracing (optionnel) ------------------
# Décommenter et configurer pour tracer les runs dans LangSmith

# LANGSMITH_TRACING_V2=true
# LANGSMITH_ENDPOINT="https://eu.api.smith.langchain.com"
# LANGSMITH_API_KEY="lsv2_pt_..."
# LANGSMITH_PROJECT="mon-projet"
# LANGCHAIN_CALLBACKS_BACKGROUNDS="false"

# ------------------ Recherche web (obligatoire pour web search) ------------------

TAVILY_API_KEY="tvly-dev-..."           # Tavily : https://tavily.com
BRAVE_SEARCH_API_KEY="BSA..."            # Brave Search (optionnel, commenté par défaut)



# ------------------ OpenAI (obligatoire) ------------------

OPENAI_API_KEY="sk-..."                  # ChatGPT clé API : https://platform.openai.com/api-keys

# ------------------ Météo (optionnel) ------------------

OPENWEATHERMAP_API_KEY="..."             # OpenWeatherMap : https://openweathermap.org/api

# ------------------ Crypto (optionnel) ------------------

COINGECKO_API_KEY="CG-..."               # CoinGecko : https://www.coingecko.com/en/api

# ------------------ Paiements (optionnel) ------------------

STRIPE_SECRET_KEY="sk_live_..."          # Stripe secret key : https://dashboard.stripe.com/apikeys

# ------------------ Mémoire long terme (optionnel) ------------------

MONGODB_ATLAS_URI=""                     # MongoDB Atlas : https://www.mongodb.com/atlas (cluster + user db). Ex. "mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net"

# ------------------ Outil PDF (optionnel) ------------------

PDF_ALLOWED_DIRS=""                      # Racines autorisées pour readPdf, séparées par ':' (défaut : répertoire courant + /tmp)
PDF_MAX_BYTES=""                         # Taille maximale d'un PDF accepté, en octets (défaut : 26214400, soit 25 Mo)
PDF_FETCH_TIMEOUT_MS=""                  # Délai maximal de téléchargement d'un PDF distant, en ms (défaut : 15000)
PDF_MAX_CHARS=""                         # Caractères de texte rendus au modèle (défaut : 40000)
