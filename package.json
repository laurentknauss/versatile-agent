{
  "name": "versatile_agent",
  "version": "1.0.0",
  "description": "LangGraph agent with tools (TypeScript 7, pnpm)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "start": "langgraphjs dev",
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"pnpm --dir assistant-ui dev\" \"langgraphjs dev\"",
    "dev:frontend": "pnpm --dir assistant-ui dev",
    "dev:backend": "langgraphjs dev",
    "typecheck": "tsc --noEmit",
    "typecheck:fast": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/openai": "^1.5.10",
    "@langchain/tavily": "latest",
    "@notionhq/client": "^3.1.3",
    "@stripe/agent-toolkit": "^0.7.10",
    "dotenv": "^16.5.0",
    "langsmith": "^0.3.33",
    "node-fetch": "^3.3.2",
    "pdf-parse": "^1.1.1",
    "stripe": "^18.4.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@langchain/langgraph-cli": "^1.4.5",
    "@types/node": "^24.13.3",
    "@types/pdf-parse": "^1.1.5",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.5.3",
    "tsx": "^4.20.3",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "zod": "3.25.67"
  },
  "pnpm": {
    "patchedDependencies": {
      "@typescript/vfs@1.6.4": "patches/@typescript__vfs.patch"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
