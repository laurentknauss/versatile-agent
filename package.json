{
  "name": "versatile_agent",
  "version": "1.0.0",
  "description": "LangGraph agent with tools (TypeScript 7, pnpm)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "scripts": {
    "build": "pnpm typecheck && pnpm --dir assistant-ui build",
    "start": "langgraphjs dev",
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"pnpm --dir assistant-ui dev\" \"langgraphjs dev\"",
    "dev:frontend": "pnpm --dir assistant-ui dev",
    "dev:backend": "langgraphjs dev",
    "typecheck": "tsc --noEmit",
    "typecheck:fast": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@langchain/core": "^1.2.11",
    "@langchain/deepseek": "^1.1.13",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/langgraph-checkpoint-mongodb": "^1.4.1",
    "@langchain/openai": "^1.5.13",
    "@langchain/tavily": "latest",
    "dotenv": "^16.5.0",
    "langchain": "^1.5.11",
    "node-fetch": "^3.3.2",
    "openai": "^7.21.0",
    "stripe": "^18.4.0",
    "unpdf": "^1.8.1",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@langchain/langgraph-cli": "^1.4.5",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.5.3",
    "tsx": "^4.20.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "zod": "3.25.67"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
